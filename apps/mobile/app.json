{
  "expo": {
    "name": "KadroRadar",
    "slug": "kadroradar",
    "scheme": "kadroradar",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F8F7",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ]
    ],
    "android": {
      "package": "com.kadroradar.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#B42335",
        "monochromeImage": "./assets/adaptive-foreground.png"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44bbc3b8-3306-4b9a-91c6-74a2eb2e0877"
      }
    },
    "owner": "ozankoca",
    "icon": "./assets/icon.png"
  }
}
