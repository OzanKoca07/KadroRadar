generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model SourceDocument {
 id String @id @default(cuid())
 originalUrl String?
 originalFilename String
 sha256 String @unique
 sourceOrganization String
 state String @default("DRAFT")
 historicalEvidence Json?
 createdAt DateTime @default(now())
 placements HistoricalPlacement[]
 gazetteImports AnnouncementImportRow[]
}
model PlacementRound {
 id String @id @default(cuid())
 year Int
 sequenceNo Int
 educationLevel String
 placements HistoricalPlacement[]
 @@unique([year,sequenceNo,educationLevel])
}
model HistoricalPlacement {
 id String @id @default(cuid())
 roundId String
 round PlacementRound @relation(fields:[roundId],references:[id])
 sourceDocumentId String
 sourceDocument SourceDocument @relation(fields:[sourceDocumentId],references:[id])
 positionCode String
 institutionRawName String
 title String
 city String
 quota Int
 placedCount Int
 vacantCount Int
 minScore Decimal? @db.Decimal(8,5)
 maxScore Decimal? @db.Decimal(8,5)
 sourcePage Int
 rawRecord Json
 approvedAt DateTime?
 @@unique([roundId,positionCode])
 @@index([city,title])
}
model ImportBatch {
 id String @id @default(cuid())
 sourceSha256 String
 state String @default("STAGED")
 rowCount Int
 errorCount Int
 createdAt DateTime @default(now())
 rows ImportRow[]
}
model ImportRow {
 id String @id @default(cuid())
 batchId String
 batch ImportBatch @relation(fields:[batchId],references:[id])
 positionCode String?
 raw Json
 issues Json
 sourcePage Int
}
model User {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 role String @default("USER")
 createdAt DateTime @default(now())
 deletedAt DateTime?
 consentVersion String?
 profile CandidateProfile?
 sessions CandidateSession[]
 saved SavedAnnouncement[]
}
model CandidateProfile {
 id String @id @default(cuid())
 userId String @unique
 user User @relation(fields:[userId],references:[id])
 educationLevel String?
 exactDegreeProgramCode String?
 kpssScore Float?
 kpssScoreType String?
 examYear Int?
 preferredCities String[] @default([])
 ydsScore Float?
 certificates String[] @default([])
 notificationConsent Boolean @default(false)
 pushToken String?
 updatedAt DateTime @updatedAt
}

model ReviewAudit {
 id String @id @default(cuid())
 batchId String
 action String
 actor String
 count Int
 createdAt DateTime @default(now())
 @@index([batchId, createdAt])
}
// Add to the END of apps/api/prisma/schema.prisma.
// HistoricalPlacement remains separate: an announcement is NOT a placement result.
model Announcement {
  id                 String    @id @default(cuid())
  title              String
  organization       String
  city               String?
  district           String?
  positionTitle      String?
  quota              Int?
  educationLevel     String?
  summary            String?
  requirements       String?
  sourceUrl          String?
  sourceEvidence     Json?
  applicationUrl     String?
  applicationStartAt DateTime?
  applicationEndAt   DateTime?
  announcedAt        DateTime?
  sourceCheckedAt    DateTime?
  status             String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED, WITHDRAWN
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  positions AnnouncementPosition[]
  savedBy SavedAnnouncement[]
  sourceReferences AnnouncementSourceReference[]

  @@index([status, applicationEndAt])
  @@index([organization, city])
  @@index([announcedAt])
}

model CandidateSession {
 id String @id
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 expiresAt DateTime
 csrfHash String
 createdAt DateTime @default(now())
 @@index([userId])
 @@index([expiresAt])
}

model AuthRateLimit {
 id String @id
 count Int
 until DateTime
}

model CandidateNotification {
 id String @id @default(cuid())
 userId String
 announcementId String
 eventKey String
 kind String
 title String
 status String @default("PENDING")
 ticketId String?
 deviceTokenHash String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([userId,eventKey])
 @@index([status,createdAt])
}

model SavedAnnouncement {
 userId String
 announcementId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 lastKnownEndAt DateTime?
 @@id([userId, announcementId])
}

model AnnouncementPosition {
 id String @id @default(cuid())
 announcementId String
 announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
 title String
 city String?
 quota Int?
 requirements Json
 sourceUrl String?
 sourceEvidence Json?
 verifiedAt DateTime?
 updatedAt DateTime @updatedAt
}

model AnnouncementImportRow {
 id String @id @default(cuid())
 sourceUrl String @unique
 contentHash String
 raw Json
 parsed Json
 issues Json
 status String @default("PENDING_REVIEW")
 version Int @default(1)
 announcementId String? @unique
 sourceDocumentId String?
 sourceDocument SourceDocument? @relation(fields:[sourceDocumentId], references:[id])
 sourceReference AnnouncementSourceReference?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 audits AnnouncementReviewAudit[]
}

model AnnouncementReviewAudit {
 id String @id @default(cuid())
 rowId String
 row AnnouncementImportRow @relation(fields: [rowId], references: [id])
 actor String
 action String
 snapshot Json
 createdAt DateTime @default(now())
}

model SourceSyncState {
 id String @id
 lastAttemptAt DateTime?
 lastSuccessAt DateTime?
 nextAttemptAt DateTime?
 consecutiveFailures Int @default(0)
 status String @default("NEVER_RUN")
 metrics Json?
 errorCode String?
 updatedAt DateTime @updatedAt
}

model AnnouncementSourceReference {
 id String @id @default(cuid())
 announcementId String
 announcement Announcement @relation(fields:[announcementId],references:[id],onDelete:Cascade)
 importRowId String @unique
 importRow AnnouncementImportRow @relation(fields:[importRowId],references:[id])
 evidence Json
 createdAt DateTime @default(now())
}
