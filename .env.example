# Copy locally only. Never commit actual credentials or production values.
NODE_ENV=production
DATABASE_URL=
CORS_ORIGINS=
# Render supplies PORT; leave unset locally to use API_PORT or 3000.
TRUST_PROXY_HOPS=1
SOURCE_SYNC_ENABLED=false
NOTIFICATIONS_ENABLED=false
ALLOW_SELF_REGISTRATION=false
# Keep false on ephemeral storage (including Render Free).
DOCUMENT_UPLOADS_ENABLED=false
GAZETTE_STORAGE_DIR=/app/.local/gazette
HISTORICAL_STORAGE_DIR=/app/.local/historical
SOURCE_STATE_DIR=/app/.local/sources
GAZETTE_RETENTION_DAYS=30
# Docker already sets INGEST_PYTHON=/opt/ingest/bin/python.
# One-time operator provisioning only; remove these after use.
NEW_ADMIN_EMAIL=
NEW_ADMIN_PASSWORD=
NEW_ADMIN_ROLE=SYSTEM_ADMIN
